{
  "rules": {
    ".read": false,
    ".write": false,
    "whomst": {
      "rooms": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && !newData.exists() && !data.child('players').exists()",
          ".validate": "$code.matches(/^[A-HJKMNP-Z]{4}$/)",
          "meta": {
            ".write": "auth != null && newData.exists() && (data.exists() ? data.child('hostUid').val() == auth.uid : newData.child('hostUid').val() == auth.uid)",
            ".validate": "newData.hasChildren(['createdAt', 'hostUid', 'phase', 'nextJoinNumber', 'roundNumber'])",
            "createdAt": { ".validate": "newData.isNumber()" },
            "hostUid": {
              ".write": "auth != null && data.exists() && newData.val() == auth.uid && root.child('whomst/rooms/' + $code + '/players/' + auth.uid).exists() && !root.child('whomst/rooms/' + $code + '/kicked/' + auth.uid).exists() && (!root.child('whomst/rooms/' + $code + '/players/' + data.val()).exists() || root.child('whomst/rooms/' + $code + '/kicked/' + data.val()).exists() || (root.child('whomst/rooms/' + $code + '/players/' + data.val() + '/online').val() == false && root.child('whomst/rooms/' + $code + '/players/' + data.val() + '/lastSeen').val() < now - 30000) || root.child('whomst/rooms/' + $code + '/players/' + auth.uid + '/joinNumber').val() < root.child('whomst/rooms/' + $code + '/players/' + data.val() + '/joinNumber').val())",
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "phase": {
              ".validate": "newData.isString() && newData.val().matches(/^(LOBBY|PROMPT|VOTE|REVEAL|SCOREBOARD|FINAL_RESULTS)$/)"
            },
            "nextJoinNumber": {
              ".write": "auth != null && data.exists() && newData.val() == data.val() + 1",
              ".validate": "newData.isNumber() && newData.val() >= 2 && (!data.exists() || newData.val() >= data.val())"
            },
            "roundNumber": { ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() >= data.val())" },
            "lastScoredRound": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "gameBaseRound": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other": { ".validate": false }
          },
          "settings": {
            ".write": "auth != null && root.child('whomst/rooms/' + $code + '/meta/hostUid').val() == auth.uid",
            "allowSubmissions": { ".validate": "newData.isBoolean()" },
            "categories": {
              "$cat": { ".validate": "$cat.matches(/^(chill|cheeky|harsh|gotcha)$/) && newData.isBoolean()" }
            },
            "$other": { ".validate": false }
          },
          "players": {
            "$uid": {
              ".write": "auth != null && (auth.uid == $uid || (!newData.exists() && (!data.exists() || (data.child('online').val() == false && data.child('lastSeen').val() < now - 30000))))",
              ".validate": "newData.hasChildren(['name', 'joinNumber', 'joinedAt', 'joinedRound', 'online', 'lastSeen']) && newData.parent().parent().child('meta').exists() && (data.exists() || !newData.parent().parent().child('kicked/' + $uid).exists())",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
              },
              "joinNumber": { ".validate": "newData.isNumber() && newData.val() >= 1" },
              "joinedAt": { ".validate": "newData.isNumber()" },
              "joinedRound": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "online": { ".validate": "newData.isBoolean()" },
              "lastSeen": { ".validate": "newData.isNumber() && newData.val() <= now" },
              "$other": { ".validate": false }
            }
          },
          "names": {
            "$key": {
              ".write": "auth != null && ((!data.exists() && newData.val() == auth.uid) || (!newData.exists() && (!data.exists() || data.val() == auth.uid || !newData.parent().parent().child('players').child(data.val()).exists())))",
              ".validate": "newData.isString() && $key.length <= 200 && newData.parent().parent().child('meta').exists()"
            }
          },
          "scores": {
            "$uid": {
              ".write": "auth != null && (root.child('whomst/rooms/' + $code + '/meta/hostUid').val() == auth.uid || (auth.uid == $uid && ((!data.exists() && newData.val() == 0) || !newData.exists())) || (!newData.exists() && !newData.parent().parent().child('players/' + $uid).exists()))",
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          },
          "prompts": {
            "$id": {
              ".write": "auth != null && (root.child('whomst/rooms/' + $code + '/meta/hostUid').val() == auth.uid || (!data.exists() && newData.child('authorUid').val() == auth.uid && newData.child('used').val() == false && root.child('whomst/rooms/' + $code + '/players/' + auth.uid).exists() && !root.child('whomst/rooms/' + $code + '/kicked/' + auth.uid).exists() && root.child('whomst/rooms/' + $code + '/settings/allowSubmissions').val() != false))",
              ".validate": "newData.hasChildren(['text', 'key', 'authorUid', 'used', 'createdAt'])",
              "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
              "key": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "authorUid": { ".validate": "newData.isString() && newData.val().length <= 128" },
              "used": { ".validate": "newData.isBoolean()" },
              "createdAt": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "drawn": {
            ".write": "auth != null && root.child('whomst/rooms/' + $code + '/meta/hostUid').val() == auth.uid",
            "$id": { ".validate": "newData.val() === true && $id.length <= 40" }
          },
          "round": {
            ".write": "auth != null && root.child('whomst/rooms/' + $code + '/meta/hostUid').val() == auth.uid",
            ".validate": "newData.hasChildren(['number', 'promptId', 'source', 'text', 'startedAt'])",
            "number": { ".validate": "newData.isNumber()" },
            "promptId": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "source": { ".validate": "newData.isString() && newData.val().matches(/^(stock|player)$/)" },
            "text": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "startedAt": { ".validate": "newData.isNumber()" },
            "eligible": { "$uid": { ".validate": "newData.val() === true" } },
            "tally": { "$uid": { ".validate": "newData.isNumber() && newData.val() >= 0" } },
            "$other": { ".validate": false }
          },
          "kicked": {
            "$uid": {
              ".write": "auth != null && root.child('whomst/rooms/' + $code + '/meta/hostUid').val() == auth.uid",
              ".validate": "newData.val() === true"
            }
          },
          "voted": {
            "$round": {
              ".validate": "$round.matches(/^r[0-9]+$/)",
              "$uid": {
                ".write": "auth != null && auth.uid == $uid && !data.exists()",
                ".validate": "newData.val() === true && newData.parent().parent().parent().child('players').child($uid).exists() && !root.child('whomst/rooms/' + $code + '/kicked/' + $uid).exists() && root.child('whomst/rooms/' + $code + '/meta/phase').val() == 'VOTE' && $round == 'r' + root.child('whomst/rooms/' + $code + '/meta/roundNumber').val() && root.child('whomst/rooms/' + $code + '/round/eligible/' + $uid).exists()"
              }
            }
          },
          "ballots": {
            "$round": {
              ".validate": "$round.matches(/^r[0-9]+$/)",
              "$ballot": {
                ".write": "auth != null && !data.exists() && !data.parent().parent().parent().child('voted').child($round).child(auth.uid).exists() && newData.parent().parent().parent().child('voted').child($round).child(auth.uid).exists()",
                ".validate": "newData.isString() && newData.parent().parent().parent().child('players').child(newData.val()).exists() && root.child('whomst/rooms/' + $code + '/meta/phase').val() == 'VOTE' && $round == 'r' + root.child('whomst/rooms/' + $code + '/meta/roundNumber').val() && root.child('whomst/rooms/' + $code + '/round/eligible/' + newData.val()).exists()"
              }
            }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
